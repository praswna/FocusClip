<Window x:Class="FocusClip.Views.PathPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="250" MinWidth="190" MinHeight="80">
    <Window.Resources>
        <!-- 팝업 스크롤바를 다크 테마로(ScrollViewer 내부 스크롤바에 암시적 적용) -->
        <Style TargetType="ScrollBar" BasedOn="{StaticResource DarkScrollBar}"/>

        <!-- 카드 붙여넣기(📋) 버튼: 카드 클릭이 '열기'가 됐으므로 붙여넣기는 이 버튼으로 -->
        <Style x:Key="CardPaste" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Foreground" Value="{StaticResource GrayBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" CornerRadius="9">
                            <TextBlock Text="📋" FontSize="10" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Opacity="0.7"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 카드 핀(📌) 버튼 -->
        <Style x:Key="CardPin" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Foreground" Value="{StaticResource GrayBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" CornerRadius="9">
                            <TextBlock Text="★" FontSize="11" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Opacity="0.55"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Bg3Brush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 카드 삭제(✕) 버튼: 평평, 호버 시 빨강 -->
        <Style x:Key="CardX" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Foreground" Value="{StaticResource GrayBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" CornerRadius="9">
                            <TextBlock Text="✕" FontSize="10" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#66FF3B30"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 필터 세그먼트(전체/로컬/URL): 선택 시 액센트, 호버 시 Bg3 -->
        <Style x:Key="SegBtn" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource GrayBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" Background="Transparent" CornerRadius="4" Padding="6,2" Margin="0,0,3,0">
                            <TextBlock Text="{TemplateBinding Content}" FontSize="10"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Bg3Brush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource NeonBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 핀 고정 시에만 보이는 이동 핸들(드래그하여 팝업 이동) -->
            <Thumb x:Name="MoveHandle" Grid.Row="0" Height="12" Visibility="Collapsed"
                   Cursor="SizeAll" Margin="0,0,0,3" DragDelta="MoveHandle_DragDelta"
                   ToolTip="드래그하여 이동">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent">
                            <Rectangle Width="40" Height="3" RadiusX="1.5" RadiusY="1.5"
                                       Fill="{StaticResource GrayBrush}" Opacity="0.6"/>
                        </Border>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>

            <!-- 헤더: 필터 세그먼트(전체/로컬/URL) + 팝업 핀 토글 -->
            <Grid Grid.Row="1" Height="26" Margin="0,0,0,4">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="경로" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"
                               FontSize="10" VerticalAlignment="Center" Margin="2,0,8,0"/>
                    <RadioButton x:Name="FilterAll" Style="{StaticResource SegBtn}" GroupName="PathFilter"
                                 Content="전체" IsChecked="True" Checked="Filter_All_Checked"/>
                    <RadioButton x:Name="FilterLocal" Style="{StaticResource SegBtn}" GroupName="PathFilter"
                                 Content="로컬" Checked="Filter_Local_Checked"/>
                    <RadioButton x:Name="FilterUrl" Style="{StaticResource SegBtn}" GroupName="PathFilter"
                                 Content="URL" Checked="Filter_Url_Checked"/>
                </StackPanel>
                <Button x:Name="CollapseButton" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,26,0" Width="24" Height="24" Padding="0" Content="▴"
                        Background="Transparent" BorderThickness="0" Foreground="{StaticResource AccentBrush}"
                        FontSize="13" Cursor="Hand" ToolTip="접기" Click="Collapse_Click"/>
                <ToggleButton x:Name="PinToggle" HorizontalAlignment="Right" VerticalAlignment="Center"
                              Width="24" Height="24" Cursor="Hand" ToolTip="창 고정(자동 닫힘 해제)"
                              Checked="PinToggle_Changed" Unchecked="PinToggle_Changed">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="pb" Background="Transparent" CornerRadius="9">
                                <TextBlock x:Name="pin" Text="&#xE718;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{StaticResource AccentBrush}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="pb" Property="Background" Value="{StaticResource AccentBrush}"/>
                                    <Setter TargetName="pin" Property="Foreground" Value="White"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="pb" Property="Background" Value="{StaticResource Bg3Brush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
            </Grid>


            <ScrollViewer Grid.Row="3" x:Name="Scroller" VerticalScrollBarVisibility="Auto" MaxHeight="320"
                          PreviewMouseWheel="Scroller_PreviewMouseWheel">
                <ItemsControl x:Name="PathList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- 고정 경로는 이 목록에 오지 않는다(오른쪽 고정 팝업이 압축 카드로 표시).
                                 카드 클릭 = 경로/URL 열기(기본 동작), 붙여넣기는 📋, 드래그는 텍스트 드롭. -->
                            <Border CornerRadius="6" Margin="0,2" Padding="6" Cursor="Hand"
                                    Background="{StaticResource Bg2Brush}"
                                    PreviewMouseLeftButtonDown="Card_PreviewMouseLeftButtonDown"
                                    PreviewMouseMove="Card_PreviewMouseMove"
                                    MouseLeftButtonUp="Card_Click"
                                    Tag="{Binding}"
                                    ToolTip="{Binding Text}">
                                <Grid>
                                    <StackPanel Margin="0">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <!-- 이동/삭제된 로컬 경로는 흐리게 -->
                                                    <DataTrigger Binding="{Binding PathExists}" Value="False">
                                                        <Setter Property="Opacity" Value="0.4"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="{Binding PathName}" Foreground="#FFDDDDDD"
                                                   FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding PathDir}" Foreground="{StaticResource GrayBrush}"
                                                   FontSize="10" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <!-- 고정 팝업처럼 동작 버튼을 한 줄로 겹쳐 카드 높이를 최소화한다. -->
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <Button Style="{StaticResource CardPin}" Click="Pin_Click"
                                                Tag="{Binding}" ToolTip="보관함에 고정(오른쪽 고정 팝업으로 이동)"/>
                                        <Button Style="{StaticResource CardPaste}" Click="Paste_Click"
                                                Tag="{Binding}" ToolTip="붙여넣기(직전 창)"/>
                                        <Button Style="{StaticResource CardX}" Click="Delete_Click"
                                                Tag="{Binding}" ToolTip="삭제"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
