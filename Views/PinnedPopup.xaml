<Window x:Class="FocusClip.Views.PinnedPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="250" MinWidth="190" MinHeight="60">
    <Window.Resources>
        <!-- 팝업 스크롤바를 다크 테마로(ScrollViewer 내부 스크롤바에 암시적 적용) -->
        <Style TargetType="ScrollBar" BasedOn="{StaticResource DarkScrollBar}"/>

        <!-- 압축 카드 버튼 공통(16px, 호버 시 액센트). 글리프는 Content 로 넘긴다
             — 버튼마다 템플릿을 복사하지 않고 한 템플릿을 공유하기 위함. -->
        <Style x:Key="MiniBtn" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="1,0,0,0"/>
            <Setter Property="Foreground" Value="{StaticResource GrayBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" CornerRadius="8">
                            <TextBlock Text="{TemplateBinding Content}" FontSize="10"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 삭제(✕) 버튼: 호버 시 빨강(기본 팝업의 CardX와 동일 규칙) -->
        <Style x:Key="MiniDelBtn" TargetType="Button" BasedOn="{StaticResource MiniBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" CornerRadius="8">
                            <TextBlock Text="{TemplateBinding Content}" FontSize="10"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#66FF3B30"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 클립 전용 버튼(경로 항목에서는 숨김) -->
        <Style x:Key="ClipOnlyBtn" TargetType="Button" BasedOn="{StaticResource MiniBtn}">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPath}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 텍스트 클립 전용 버튼(이미지·경로 항목에서는 숨김) -->
        <Style x:Key="TextOnlyBtn" TargetType="Button" BasedOn="{StaticResource MiniBtn}">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPath}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsImage}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 경로 전용 버튼(클립 항목에서는 숨김) — 경로 카드는 클릭이 '열기'라 붙여넣기를 버튼으로 둔다 -->
        <Style x:Key="PathOnlyBtn" TargetType="Button" BasedOn="{StaticResource MiniBtn}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPath}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource NeonBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 핀 고정 시에만 보이는 이동 핸들(드래그하여 팝업 이동) -->
            <Thumb x:Name="MoveHandle" Grid.Row="0" Height="12" Visibility="Collapsed"
                   Cursor="SizeAll" Margin="0,0,0,3" DragDelta="MoveHandle_DragDelta"
                   ToolTip="드래그하여 이동">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent">
                            <Rectangle Width="40" Height="3" RadiusX="1.5" RadiusY="1.5"
                                       Fill="{StaticResource GrayBrush}" Opacity="0.6"/>
                        </Border>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>

            <!-- 헤더: 제목(고정 클립/고정 경로) + 개수 + 팝업 핀 토글 -->
            <Grid Grid.Row="1" Height="26" Margin="0,0,0,3">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderText" Text="고정" Foreground="{StaticResource AccentBrush}"
                               FontWeight="SemiBold" FontSize="10" VerticalAlignment="Center" Margin="2,0,6,0"/>
                    <TextBlock x:Name="CountText" Foreground="{StaticResource GrayBrush}"
                               FontSize="10" VerticalAlignment="Center"/>
                </StackPanel>
                <Button x:Name="CollapseButton" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,26,0" Width="24" Height="24" Padding="0" Content="▴"
                        Background="Transparent" BorderThickness="0" Foreground="{StaticResource AccentBrush}"
                        FontSize="13" Cursor="Hand" ToolTip="접기" Click="Collapse_Click"/>
                <ToggleButton x:Name="PinToggle" HorizontalAlignment="Right" VerticalAlignment="Center"
                              Width="24" Height="24" Cursor="Hand" ToolTip="창 고정(자동 닫힘 해제)"
                              Checked="PinToggle_Changed" Unchecked="PinToggle_Changed">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="pb" Background="Transparent" CornerRadius="9">
                                <TextBlock x:Name="pin" Text="&#xE718;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{StaticResource AccentBrush}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="pb" Property="Background" Value="{StaticResource AccentBrush}"/>
                                    <Setter TargetName="pin" Property="Foreground" Value="White"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="pb" Property="Background" Value="{StaticResource Bg3Brush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
            </Grid>


            <ScrollViewer Grid.Row="3" x:Name="Scroller" VerticalScrollBarVisibility="Auto" MaxHeight="320"
                          PreviewMouseWheel="Scroller_PreviewMouseWheel">
                <ItemsControl x:Name="PinList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- 압축 카드: 썸네일(이미지) + 두 줄 텍스트 + 버튼 한 줄 → 높이 고정(기본 팝업 카드의 1/3).
                                 클릭은 기본 팝업과 동일 — 클립은 붙여넣기, 경로는 열기. -->
                            <Border CornerRadius="5" Margin="0,1" Padding="5,3" Cursor="Hand"
                                    Background="#FF143A37"
                                    MouseLeftButtonUp="Card_Click"
                                    PreviewMouseLeftButtonDown="Card_PreviewMouseLeftButtonDown"
                                    PreviewMouseMove="Card_PreviewMouseMove"
                                    Tag="{Binding}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <!-- 툴팁은 Snippet(최대 300자) — 긴 본문이 화면을 덮지 않게 -->
                                        <Setter Property="ToolTip" Value="{Binding Snippet}"/>
                                        <Style.Triggers>
                                            <!-- 이미지 클립은 본문이 없어 툴팁을 달지 않는다(빈 툴팁 방지) -->
                                            <DataTrigger Binding="{Binding IsImage}" Value="True">
                                                <Setter Property="ToolTip" Value="{x:Null}"/>
                                            </DataTrigger>
                                            <!-- 이동/삭제된 로컬 경로는 흐리게(기본 경로 팝업과 동일) -->
                                            <DataTrigger Binding="{Binding PathExists}" Value="False">
                                                <Setter Property="Opacity" Value="0.45"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Image Grid.Column="0" Source="{Binding Thumb}" Stretch="Uniform"
                                           MaxHeight="26" MaxWidth="40" Margin="0,0,5,0">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsImage}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PinTitle}" Foreground="#FFDDDDDD"
                                                   FontSize="11" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding PinSubtitle}" Foreground="{StaticResource GrayBrush}"
                                                   FontSize="9" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource MiniBtn}" Content="★"
                                                Click="Unpin_Click" Tag="{Binding}" ToolTip="보관 해제(기본 팝업으로 이동)"/>
                                        <Button Style="{StaticResource ClipOnlyBtn}" Content="✎"
                                                Click="Edit_Click" Tag="{Binding}" ToolTip="수정"/>
                                        <Button Style="{StaticResource TextOnlyBtn}" Content="🔖"
                                                Click="Promote_Click" Tag="{Binding}" ToolTip="프롬프트로 저장"/>
                                        <Button Style="{StaticResource ClipOnlyBtn}" Content="📂"
                                                Click="Open_Click" Tag="{Binding}" ToolTip="저장 위치 열기"/>
                                        <Button Style="{StaticResource PathOnlyBtn}" Content="📋"
                                                Click="Paste_Click" Tag="{Binding}" ToolTip="붙여넣기(직전 창)"/>
                                        <Button Style="{StaticResource MiniDelBtn}" Content="✕"
                                                Click="Delete_Click" Tag="{Binding}" ToolTip="삭제"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
