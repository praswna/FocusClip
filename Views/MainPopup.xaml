<Window x:Class="FocusClip.Views.MainPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        Width="300" Height="460">
    <Window.Resources>
        <!-- 팝업 스크롤바를 다크 테마로(ScrollViewer 내부 스크롤바에 암시적 적용) -->
        <Style TargetType="ScrollBar" BasedOn="{StaticResource DarkScrollBar}"/>

        <!-- 세그먼트 버튼: 탭(클립/경로/프롬프트)과 필터(전체/텍스트/…)가 함께 쓴다 -->
        <Style x:Key="SegBtn" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource GrayBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" Background="Transparent" CornerRadius="4" Padding="6,2" Margin="0,0,3,0">
                            <TextBlock Text="{TemplateBinding Content}" FontSize="10"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Bg3Brush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 탭 버튼: 세그먼트와 같은 모양이되 조금 크게(클릭 대상) -->
        <Style x:Key="TabBtn" TargetType="RadioButton" BasedOn="{StaticResource SegBtn}">
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- 카드 삭제(✕) 버튼: 평평, 호버 시 빨강 -->
        <Style x:Key="CardX" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Foreground" Value="{StaticResource GrayBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" CornerRadius="9">
                            <TextBlock Text="✕" FontSize="10" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#66FF3B30"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 카드 편집(✎) 버튼 -->
        <Style x:Key="CardEdit" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Foreground" Value="{StaticResource GrayBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" CornerRadius="9">
                            <TextBlock Text="✎" FontSize="11" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 카드 프롬프트 승격(🔖) 버튼: 텍스트 클립을 프롬프트 보관함으로 -->
        <Style x:Key="CardPromote" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Foreground" Value="{StaticResource GrayBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" CornerRadius="9">
                            <TextBlock Text="🔖" FontSize="10" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Opacity="0.7"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 카드 경로열기(📂) 버튼: 저장된 본문 파일 위치를 탐색기로 -->
        <Style x:Key="CardOpen" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Foreground" Value="{StaticResource GrayBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" CornerRadius="9">
                            <TextBlock Text="📂" FontSize="10" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Opacity="0.7"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Bg3Brush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 카드 붙여넣기(📋) 버튼: 경로 카드는 클릭이 '열기'라 붙여넣기를 버튼으로 둔다 -->
        <Style x:Key="CardPaste" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Foreground" Value="{StaticResource GrayBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" CornerRadius="9">
                            <TextBlock Text="📋" FontSize="10" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Opacity="0.7"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 카드 보관(★) 버튼 -->
        <Style x:Key="CardPin" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Foreground" Value="{StaticResource GrayBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" CornerRadius="9">
                            <TextBlock Text="★" FontSize="11" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Opacity="0.55"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Bg3Brush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 헤더 추가(+) 버튼: 프롬프트 탭 -->
        <Style x:Key="AddBtn" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" CornerRadius="4">
                            <TextBlock Text="＋" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── 고정(★) 압축 카드 버튼들 ── -->
        <Style x:Key="MiniBtn" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="1,0,0,0"/>
            <Setter Property="Foreground" Value="{StaticResource GrayBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" CornerRadius="8">
                            <TextBlock Text="{TemplateBinding Content}" FontSize="10"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MiniDelBtn" TargetType="Button" BasedOn="{StaticResource MiniBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" CornerRadius="8">
                            <TextBlock Text="{TemplateBinding Content}" FontSize="10"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#66FF3B30"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 클립 전용 버튼(경로 항목에서는 숨김) -->
        <Style x:Key="ClipOnlyBtn" TargetType="Button" BasedOn="{StaticResource MiniBtn}">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPath}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 텍스트 클립 전용 버튼(이미지·경로 항목에서는 숨김) -->
        <Style x:Key="TextOnlyBtn" TargetType="Button" BasedOn="{StaticResource MiniBtn}">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPath}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsImage}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 경로 전용 버튼(클립 항목에서는 숨김) -->
        <Style x:Key="PathOnlyBtn" TargetType="Button" BasedOn="{StaticResource MiniBtn}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPath}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ── 고정(★) 항목 압축 카드: 클립·경로 공용. 각 탭 목록 맨 위에 붙는다 ── -->
        <DataTemplate x:Key="PinnedCardTemplate">
            <Border CornerRadius="5" Margin="0,1" Padding="5,3" Cursor="Hand"
                    Background="#FF143A37"
                    MouseLeftButtonUp="PinCard_Click"
                    PreviewMouseLeftButtonDown="Card_Down"
                    PreviewMouseMove="Card_Move"
                    Tag="{Binding}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="ToolTip" Value="{Binding Snippet}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsImage}" Value="True">
                                <Setter Property="ToolTip" Value="{x:Null}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding PathExists}" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0" Source="{Binding Thumb}" Stretch="Uniform"
                           MaxHeight="26" MaxWidth="40" Margin="0,0,5,0">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsImage}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PinTitle}" Foreground="#FFDDDDDD"
                                   FontSize="11" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding PinSubtitle}" Foreground="{StaticResource GrayBrush}"
                                   FontSize="9" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource MiniBtn}" Content="★"
                                Click="Pin_Click" Tag="{Binding}" ToolTip="보관 해제(아래 목록으로 이동)"/>
                        <Button Style="{StaticResource ClipOnlyBtn}" Content="✎"
                                Click="Edit_Click" Tag="{Binding}" ToolTip="수정"/>
                        <Button Style="{StaticResource TextOnlyBtn}" Content="🔖"
                                Click="Promote_Click" Tag="{Binding}" ToolTip="프롬프트로 저장"/>
                        <Button Style="{StaticResource ClipOnlyBtn}" Content="📂"
                                Click="Open_Click" Tag="{Binding}" ToolTip="저장 위치 열기"/>
                        <Button Style="{StaticResource PathOnlyBtn}" Content="📋"
                                Click="Paste_Click" Tag="{Binding}" ToolTip="붙여넣기(직전 창)"/>
                        <Button Style="{StaticResource MiniDelBtn}" Content="✕"
                                Click="Delete_Click" Tag="{Binding}" ToolTip="삭제"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ── 클립 카드 ── -->
        <DataTemplate x:Key="ClipCardTemplate">
            <Border CornerRadius="6" Margin="0,2" Padding="6" Cursor="Hand"
                    Background="{StaticResource Bg2Brush}"
                    MouseLeftButtonUp="ClipCard_Click"
                    PreviewMouseLeftButtonDown="Card_Down"
                    PreviewMouseMove="Card_Move"
                    Tag="{Binding}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Image Grid.Row="0" Source="{Binding Thumb}" Stretch="Uniform"
                           MaxHeight="88" HorizontalAlignment="Left">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsImage}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>

                    <TextBlock Grid.Row="0" Text="{Binding Snippet}" Foreground="#FFDDDDDD"
                               TextWrapping="Wrap" MaxHeight="110" TextTrimming="CharacterEllipsis"
                               Margin="0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsImage}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- 카드 위에 가로로 겹쳐 표시해 버튼 수가 카드 높이를 키우지 않게 한다. -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal"
                                HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Button Style="{StaticResource CardEdit}" Click="Edit_Click"
                                Tag="{Binding}" ToolTip="수정"/>
                        <Button Click="Promote_Click" Tag="{Binding}" ToolTip="프롬프트로 저장">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource CardPromote}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsImage}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Style="{StaticResource CardPin}" Click="Pin_Click"
                                Tag="{Binding}" ToolTip="보관함에 고정(목록 맨 위로)"/>
                        <Button Style="{StaticResource CardOpen}" Click="Open_Click"
                                Tag="{Binding}" ToolTip="저장 위치 열기"/>
                        <Button Style="{StaticResource CardX}" Click="Delete_Click"
                                Tag="{Binding}" ToolTip="삭제"/>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Text="{Binding TimeLabel}" Foreground="{StaticResource GrayBrush}"
                               FontSize="10" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ── 경로 카드 ── -->
        <DataTemplate x:Key="PathCardTemplate">
            <Border CornerRadius="6" Margin="0,2" Padding="6" Cursor="Hand"
                    Background="{StaticResource Bg2Brush}"
                    PreviewMouseLeftButtonDown="Card_Down"
                    PreviewMouseMove="Card_Move"
                    MouseLeftButtonUp="PathCard_Click"
                    Tag="{Binding}"
                    ToolTip="{Binding Text}">
                <Grid>
                    <StackPanel Margin="0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PathExists}" Value="False">
                                        <Setter Property="Opacity" Value="0.4"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{Binding PathName}" Foreground="#FFDDDDDD"
                                   FontSize="12" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding PathDir}" Foreground="{StaticResource GrayBrush}"
                                   FontSize="10" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Button Style="{StaticResource CardPin}" Click="Pin_Click"
                                Tag="{Binding}" ToolTip="보관함에 고정(목록 맨 위로)"/>
                        <Button Style="{StaticResource CardPaste}" Click="Paste_Click"
                                Tag="{Binding}" ToolTip="붙여넣기(직전 창)"/>
                        <Button Style="{StaticResource CardX}" Click="Delete_Click"
                                Tag="{Binding}" ToolTip="삭제"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ── 프롬프트 카드 ── -->
        <DataTemplate x:Key="PromptCardTemplate">
            <Border CornerRadius="6" Margin="0,2" Padding="6" Cursor="Hand"
                    Background="{StaticResource Bg2Brush}"
                    PreviewMouseLeftButtonDown="Card_Down"
                    PreviewMouseMove="Card_Move"
                    MouseLeftButtonUp="PromptCard_Click"
                    Tag="{Binding}"
                    ToolTip="{Binding Text}">
                <Grid>
                    <StackPanel Margin="0">
                        <TextBlock Text="{Binding DisplayTitle}" Foreground="#FFDDDDDD"
                                   FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Preview}" Foreground="{StaticResource GrayBrush}"
                                   FontSize="10" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Button Style="{StaticResource CardEdit}" Click="PromptEdit_Click"
                                Tag="{Binding}" ToolTip="편집"/>
                        <Button Style="{StaticResource CardX}" Click="PromptDelete_Click"
                                Tag="{Binding}" ToolTip="삭제"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Border Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource NeonBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 핀 고정 시에만 보이는 이동 핸들(드래그하여 창 이동) -->
            <Thumb x:Name="MoveHandle" Grid.Row="0" Height="12" Visibility="Collapsed"
                   Cursor="SizeAll" Margin="0,0,0,3" DragDelta="MoveHandle_DragDelta"
                   ToolTip="드래그하여 이동">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent">
                            <Rectangle Width="40" Height="3" RadiusX="1.5" RadiusY="1.5"
                                       Fill="{StaticResource GrayBrush}" Opacity="0.6"/>
                        </Border>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>

            <!-- 헤더: 탭(클립/경로/프롬프트) + 저장 개수 + 접기 + 창 고정 -->
            <Grid Grid.Row="1" Height="26" Margin="0,0,0,4">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <RadioButton x:Name="TabClip" Style="{StaticResource TabBtn}" GroupName="MainTabs"
                                 Content="클립" IsChecked="True" Checked="Tab_Checked"/>
                    <RadioButton x:Name="TabPath" Style="{StaticResource TabBtn}" GroupName="MainTabs"
                                 Content="경로" Checked="Tab_Checked"/>
                    <RadioButton x:Name="TabPrompt" Style="{StaticResource TabBtn}" GroupName="MainTabs"
                                 Content="프롬프트" Checked="Tab_Checked"/>
                </StackPanel>
                <TextBlock x:Name="FolderCount" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Margin="0,0,52,0" FontSize="10" Foreground="{StaticResource GrayBrush}"
                           Cursor="Hand" ToolTip="저장 폴더의 파일 수 (클릭 = 폴더 열기)"
                           MouseLeftButtonUp="FolderCount_Click"/>
                <Button x:Name="CollapseButton" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,26,0" Width="24" Height="24" Padding="0" Content="▴"
                        Background="Transparent" BorderThickness="0" Foreground="{StaticResource AccentBrush}"
                        FontSize="13" Cursor="Hand" ToolTip="접기" Click="Collapse_Click"/>
                <ToggleButton x:Name="PinToggle" HorizontalAlignment="Right" VerticalAlignment="Center"
                              Width="24" Height="24" Cursor="Hand" ToolTip="창 고정(자동 닫힘 해제)"
                              Checked="PinToggle_Changed" Unchecked="PinToggle_Changed">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="pb" Background="Transparent" CornerRadius="9">
                                <TextBlock x:Name="pin" Text="&#xE718;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{StaticResource AccentBrush}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="pb" Property="Background" Value="{StaticResource AccentBrush}"/>
                                    <Setter TargetName="pin" Property="Foreground" Value="White"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="pb" Property="Background" Value="{StaticResource Bg3Brush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
            </Grid>

            <!-- 탭 내용: 한 번에 하나만 보인다(고정 높이라 탭을 바꿔도 창 크기·위치가 그대로) -->
            <Grid x:Name="TabArea" Grid.Row="2">

                <!-- 클립 탭 -->
                <Grid x:Name="ClipTab">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                        <RadioButton x:Name="ClipFilterAll" Style="{StaticResource SegBtn}" GroupName="ClipFilter"
                                     Content="전체" IsChecked="True" Checked="ClipFilter_All"/>
                        <RadioButton x:Name="ClipFilterText" Style="{StaticResource SegBtn}" GroupName="ClipFilter"
                                     Content="텍스트" Checked="ClipFilter_Text"/>
                        <RadioButton x:Name="ClipFilterImage" Style="{StaticResource SegBtn}" GroupName="ClipFilter"
                                     Content="이미지" Checked="ClipFilter_Image"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" x:Name="ClipScroller" VerticalScrollBarVisibility="Auto"
                                  PreviewMouseWheel="Scroller_PreviewMouseWheel">
                        <StackPanel>
                            <!-- 고정(★)한 클립: 압축 카드로 목록 맨 위에 -->
                            <ItemsControl x:Name="PinnedClipList" ItemTemplate="{StaticResource PinnedCardTemplate}"/>
                            <ItemsControl x:Name="ClipList" ItemTemplate="{StaticResource ClipCardTemplate}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 경로 탭 -->
                <Grid x:Name="PathTab" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                        <RadioButton x:Name="PathFilterAll" Style="{StaticResource SegBtn}" GroupName="PathFilter"
                                     Content="전체" IsChecked="True" Checked="PathFilter_All"/>
                        <RadioButton x:Name="PathFilterLocal" Style="{StaticResource SegBtn}" GroupName="PathFilter"
                                     Content="로컬" Checked="PathFilter_Local"/>
                        <RadioButton x:Name="PathFilterUrl" Style="{StaticResource SegBtn}" GroupName="PathFilter"
                                     Content="URL" Checked="PathFilter_Url"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" x:Name="PathScroller" VerticalScrollBarVisibility="Auto"
                                  PreviewMouseWheel="Scroller_PreviewMouseWheel">
                        <StackPanel>
                            <!-- 고정(★)한 경로: 압축 카드로 목록 맨 위에 -->
                            <ItemsControl x:Name="PinnedPathList" ItemTemplate="{StaticResource PinnedCardTemplate}"/>
                            <ItemsControl x:Name="PathList" ItemTemplate="{StaticResource PathCardTemplate}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 프롬프트 탭 -->
                <Grid x:Name="PromptTab" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                        <Button x:Name="AddButton" Style="{StaticResource AddBtn}" Click="Add_Click"
                                ToolTip="프롬프트 추가"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" x:Name="PromptScroller" VerticalScrollBarVisibility="Auto"
                                  PreviewMouseWheel="Scroller_PreviewMouseWheel">
                        <ItemsControl x:Name="PromptList" ItemTemplate="{StaticResource PromptCardTemplate}"/>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
